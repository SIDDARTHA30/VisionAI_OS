# ==============================================================================
# VisionAI-OS Environment Configuration Template
# ==============================================================================

# Database Setup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=visionai_db
DATABASE_URL=postgresql+asyncpg://postgres:securepassword@localhost:5432/visionai_db

# Redis Setup
REDIS_URL=redis://localhost:6379/0

# pgAdmin Setup
PGADMIN_EMAIL=admin@visionai.local
PGADMIN_PASSWORD=adminpassword

# Security & Authentication
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=supersecretjwtsecretkeyhere1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Setup
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI APIs
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
